{
  "name": "link-server",
  "version": "1.0.0",
  "description": "Telegram APK Download Server with Update Management APIs",
  "main": "server.js",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "docker:build": "docker build -t link-server .",
    "docker:run": "docker run -p 3000:3000 link-server",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:compose": "docker-compose up -d",
    "docker:compose:prod": "docker-compose --profile production up -d"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "gridfs-stream": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "express",
    "apk",
    "download",
    "server",
    "nodejs",
    "telegram",
    "update-management",
    "mobile-app-updates",
    "ota-updates"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/link-server.git"
  },
  "homepage": "https://github.com/yourusername/link-server#readme"
}
